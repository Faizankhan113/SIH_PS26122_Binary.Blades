# Choose: gemini or groq
LLM_PROVIDER=gemini

# Gemini: current stable Flash model selected after benchmarking.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash

# Groq (used after Gemini for comparison)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b

# Project timezone for all stored timestamps (IANA name). Default: Asia/Kolkata
# PS26122_TIMEZONE=Asia/Kolkata

# Project id used only for a schedule row that has none. Default: GPC-001
# PS26122_DEFAULT_PROJECT_ID=GPC-001

# PostgreSQL connection (required). Create the database and user first, see the README.
# If the password has special characters (@ : / # %), percent-encode them, e.g. @ -> %40.
DATABASE_URL=postgresql://ps26122_user:your_password@localhost:5432/ps26122

# Web app. FLASK_SECRET_KEY signs the login cookie; there is no default. If it is
# missing a random key is used until restart (and a warning is printed).
# Make one:  python -c "import secrets; print(secrets.token_hex(32))"
# FLASK_SECRET_KEY=
# Debug mode (auto-reload + interactive debugger). Off unless set to 1.
# FLASK_DEBUG=1

# Statements extracted at the same time (default 4)
# PS26122_EXTRACT_WORKERS=4
# Delete report-run working data untouched for this many hours (default 24)
# PS26122_RUN_TTL_HOURS=24

# LLM calls: time limit per call, retries for 429/transient errors, first retry wait
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_RETRY_BASE_SECONDS=1
